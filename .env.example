# Prefer 127.0.0.1 over localhost on Windows (avoids IPv6 / pool timeout issues).
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE_NAME"

# Публичный URL сайта (metadataBase, sitemap, OG, JSON-LD). Без хвостового /
# В production обязателен HTTPS-origin (не localhost).
NEXT_PUBLIC_SITE_URL="https://example.com"

# Верификация вебмастеров (meta verification). Пусто = теги не выводятся.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Яндекс.Метрика. Пусто = счётчик не подключается.
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Сессии / подпись cookie (обязателен в production)
AUTH_SECRET="change-me-to-a-long-random-string"

# OTP: stub (локально, код 000000) | verificahub
OTP_PROVIDER=verificahub
VERIFICAHUB_API_KEY=
VERIFICAHUB_API_SECRET=

# Telegram Bot: уведомление о новом заказе в группу
BOT_TOKEN=
CHAT_ID=

# Cloudflare Worker proxy для Bot API (пусто = прямой api.telegram.org)
TELEGRAM_PROXY_URL=
TELEGRAM_PROXY_SECRET=
