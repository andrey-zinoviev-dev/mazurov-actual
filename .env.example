# Prefer 127.0.0.1 over localhost on Windows (avoids IPv6 / pool timeout issues).
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE_NAME"

# Сессии / хэш OTP (обязателен в production)
AUTH_SECRET="change-me-to-a-long-random-string"

# OTP: stub (лог в консоль) | telegram_gateway
OTP_PROVIDER=telegram_gateway
TELEGRAM_GATEWAY_TOKEN=

# Cloudflare Worker proxy (пусто = прямой api.telegram.org / gatewayapi.telegram.org)
TELEGRAM_PROXY_URL=https://your-worker.workers.dev
TELEGRAM_PROXY_SECRET=

# Telegram Bot: уведомление о новом заказе в группу
BOT_TOKEN=
CHAT_ID=
